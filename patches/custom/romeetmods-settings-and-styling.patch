   SkColor background_color = GetBackgroundColor(
       state, is_active, is_hovered, is_selected, has_custom_theme, color_provider);
 
+  // RomeetMods: Custom styling for vertical unpinned tabs
+  if (tabs::IsVerticalTabsExpandOnHoverFeatureEnabled() || tabs::CanShowVerticalTabs()) {
+    if (is_active || is_selected) {
+      // Active tab: Accent color fill
+      background_color = color_provider->GetColor(ui::kColorSysPrimary);
+    } else {
+      // Inactive tab: Borderless greyish background
+      background_color = color_provider->IsDarkMode() ? SkColorSetARGB(22, 255, 255, 255)
+                                                      : SkColorSetARGB(18, 0, 0, 0);
+    }
+  }
+
   flags.setColor(background_color);
   canvas->DrawPath(path, flags);
 }
